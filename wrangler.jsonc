{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roomplaner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_BASE_PATH": "/RoomPlanner",
    "LEGACY_BASE_PATH": "/RoomPlaner",
    "DEPLOYMENT": "production",
  },
  "routes": [
    {
      "pattern": "holtsdav.com/RoomPlanner*",
      "zone_name": "holtsdav.com",
    },
    {
      "pattern": "holtsdav.com/RoomPlaner*",
      "zone_name": "holtsdav.com",
    },
  ],
  "env": {
    "develop": {
      "name": "roomplaner-develop",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_BASE_PATH": "/dev/RoomPlanner",
        "LEGACY_BASE_PATH": "/dev/RoomPlaner",
        "DEPLOYMENT": "develop",
      },
      "routes": [
        {
          "pattern": "holtsdav.com/dev/RoomPlanner*",
          "zone_name": "holtsdav.com",
        },
        {
          "pattern": "holtsdav.com/dev/RoomPlaner*",
          "zone_name": "holtsdav.com",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LOGIN_GUARD",
            "class_name": "LoginGuard",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["LoginGuard"],
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": true,
      },
      "secrets": {
        "required": ["DEV_PASSWORD"],
      },
    },
  },
}
